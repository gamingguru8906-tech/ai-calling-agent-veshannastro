# ===== Required =====
DATABASE_URL=postgresql://user:pass@your-neon-host/dbname?sslmode=require

# ===== Razorpay (payment links) =====
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ===== WhatsApp — pick ONE =====
# Option A: AiSensy (cheapest for India)
AISENSY_API_KEY=
AISENSY_CAMPAIGN=vapi_booking_confirm

# Option B: Twilio
TWILIO_SID=
TWILIO_AUTH=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== Optional =====
GSHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
ADMIN_KEY=some_secret_key_for_viewing_bookings
PORT=3000

# ===== Free email (Gmail SMTP, 500/day) =====
# Create an App Password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
